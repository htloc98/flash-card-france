    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "wrangler": "^4.160.1"
  }
